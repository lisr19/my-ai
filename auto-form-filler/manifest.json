{
  "manifest_version": 3,
  "name": "智能表单自动填充",
  "version": "3.6.3",
  "description": "一键自动填写任意网页表单，零配置，支持Element UI/Ant Design等所有框架，支持iframe内嵌表单，支持DeepSeek AI智能生成数据",
  "permissions": ["activeTab", "storage", "notifications", "sidePanel"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开智能表单填充面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["autoFiller.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
