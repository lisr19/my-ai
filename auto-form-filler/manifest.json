{"manifest_version": 3, "name": "智能表单自动填充", "version": "3.5.0", "description": "一键自动填写任意网页表单，零配置，支持Element UI/Ant Design等所有框架，支持iframe内嵌表单，支持DeepSeek AI智能生成数据", "permissions": ["activeTab", "storage", "notifications"], "host_permissions": ["https://api.deepseek.com/*"], "background": {"service_worker": "background.js"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["autoFiller.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}]}